# FlipScan configuration.
# Copy to .env and fill in. `flipscan init` generates this with real secrets.
# NEVER commit .env — it holds your access token and API keys.

# --------------------------------------------------------------------------
# Required
# --------------------------------------------------------------------------
# Shared secret the phone sends to the API. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FLIPSCAN_API_TOKEN=

# Private ntfy topic for push notifications. Subscribe to this exact string in
# the free ntfy iOS app. Anyone who knows it can read your alerts, so make it
# long and random — not "flipscan-deals".
FLIPSCAN_NOTIFY__NTFY_TOPIC=

# --------------------------------------------------------------------------
# Strongly recommended
# --------------------------------------------------------------------------
# Photo condition grading and web research. Without it, deals are graded from
# listing text alone, which misses damage the seller didn't mention.
# console.anthropic.com
FLIPSCAN_ANTHROPIC_API_KEY=

# eBay comps — free developer keys at developer.ebay.com. This is the single
# biggest accuracy win available: without it, resale values are category
# averages rather than real comparable sales.
FLIPSCAN_SOURCES__EBAY_CLIENT_ID=
FLIPSCAN_SOURCES__EBAY_CLIENT_SECRET=
# Only set true after eBay approves Marketplace Insights (real SOLD prices).
FLIPSCAN_SOURCES__EBAY_HAS_INSIGHTS_ACCESS=false

# --------------------------------------------------------------------------
# Market — defaults to Portland, OR
# --------------------------------------------------------------------------
FLIPSCAN_MARKET__CENTER_LAT=45.5152
FLIPSCAN_MARKET__CENTER_LON=-122.6784
FLIPSCAN_MARKET__SEARCH_RADIUS_MILES=60

# --------------------------------------------------------------------------
# What counts as a deal
# --------------------------------------------------------------------------
FLIPSCAN_PROFIT__MIN_NET_PROFIT=60
FLIPSCAN_PROFIT__MIN_ROI_PCT=45
FLIPSCAN_PROFIT__MAX_BUY_PRICE=2500
FLIPSCAN_PROFIT__MIN_DEAL_SCORE=55
# Listings at or above this scam score are blocked no matter how good the
# margin looks.
FLIPSCAN_PROFIT__MAX_SCAM_RISK=70

# --------------------------------------------------------------------------
# How far to drive
# --------------------------------------------------------------------------
# The radius scales with expected profit — see docs/HOW-IT-SCORES.md.
FLIPSCAN_TRIP__MAX_RADIUS_MILES=60
FLIPSCAN_TRIP__MIN_RADIUS_MILES=5
FLIPSCAN_TRIP__COST_PER_MILE=0.35
FLIPSCAN_TRIP__HOURLY_TIME_VALUE=25
# Most of a deal's profit you'll spend getting there. Raise to travel further.
FLIPSCAN_TRIP__MAX_TRIP_COST_FRACTION=0.25

# --------------------------------------------------------------------------
# Scanning
# --------------------------------------------------------------------------
FLIPSCAN_SCAN__INTERVAL_MINUTES=60
FLIPSCAN_SCAN__QUIET_HOURS_START=22
FLIPSCAN_SCAN__QUIET_HOURS_END=7
FLIPSCAN_SCAN__TIMEZONE=America/Los_Angeles

# Comma-separated. Start with 'demo' to try everything without touching
# Facebook; switch to 'facebook' after running `flipscan login`.
FLIPSCAN_SOURCES__COLLECTORS=demo
FLIPSCAN_SOURCES__BROWSER_HEADLESS=true

# Daily ceiling on AI analysis spend. The staged pipeline normally lands well
# under this — see docs/HOW-IT-SCORES.md.
FLIPSCAN_AI__DAILY_BUDGET_USD=3.00

# --------------------------------------------------------------------------
# Networking
# --------------------------------------------------------------------------
# Public URL of this server. Used for links inside notifications, so it must
# be reachable from the phone.
FLIPSCAN_PUBLIC_BASE_URL=http://localhost:8000
FLIPSCAN_PORT=8000
FLIPSCAN_LOG_LEVEL=INFO

# --------------------------------------------------------------------------
# Optional notification channels
# --------------------------------------------------------------------------
# FLIPSCAN_NOTIFY__CHANNELS=ntfy,webpush
# Generate with: flipscan vapid-keys
# FLIPSCAN_NOTIFY__VAPID_PUBLIC_KEY=
# FLIPSCAN_NOTIFY__VAPID_PRIVATE_KEY=
# FLIPSCAN_NOTIFY__VAPID_CONTACT_EMAIL=

# Native APNs, for the SwiftUI build only.
# FLIPSCAN_NOTIFY__APNS_KEY_ID=
# FLIPSCAN_NOTIFY__APNS_TEAM_ID=
# FLIPSCAN_NOTIFY__APNS_KEY_PATH=/app/data/AuthKey.p8
# FLIPSCAN_NOTIFY__APNS_USE_SANDBOX=true

# SMS backup for very large finds only (~$0.008/message).
# FLIPSCAN_NOTIFY__TWILIO_ACCOUNT_SID=
# FLIPSCAN_NOTIFY__TWILIO_AUTH_TOKEN=
# FLIPSCAN_NOTIFY__TWILIO_FROM=+15035550100
# FLIPSCAN_NOTIFY__TWILIO_TO=+15035550101
# FLIPSCAN_NOTIFY__SMS_MIN_PROFIT=400
